{
  "name": "open-task-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de tarefas, planejamento com Gantt e rastreamento de tempo inspirado no Toggl.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @ott/web && npm run build -w @ott/api",
    "start": "npm run start -w @ott/api",
    "seed": "npm run seed -w @ott/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:text": "node scripts/check-text.mjs",
    "check": "npm run check:text && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "7.3.6"
  }
}
