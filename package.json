{
  "name": "open-task-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de tarefas, planejamento com Gantt e rastreamento de tempo inspirado no Toggl, com Firebase ou lowdb local.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ott/web",
    "build": "npm run build -w @ott/web",
    "preview": "npm run preview -w @ott/web",
    "test": "npm run test --workspaces --if-present",
    "test:firebase": "npx --yes firebase-tools@15.31.0 emulators:exec --only auth,firestore --project demo-ott \"npm run test:emulator -w @ott/data\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:text": "node scripts/check-text.mjs",
    "themes": "node scripts/workspace-themes.mjs",
    "check:themes": "node scripts/workspace-themes.mjs --check",
    "check": "npm run check:text && npm run check:themes && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "7.3.6",
    "@grpc/grpc-js": "1.13.6"
  }
}
