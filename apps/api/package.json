  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.4",
    "@ott/shared": "0.1.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "tsx": "4.23.15"
  }
}
