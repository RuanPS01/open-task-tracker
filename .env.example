# Copie para .env (na raiz) e preencha. Sem as variáveis do Firebase, o app roda no
# modo local: dados no navegador, com lowdb sobre o localStorage.
# No GitHub Actions elas vêm dos secrets do repositório (ver docs/02-tecnologias.md).

# Configuração do app web do Firebase (Console > Configurações do projeto > Seus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcionais.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# auto (padrão): Firebase se configurado e respondendo, senão local.
# firebase: só Firebase (falha se não conectar). local: sempre local.
VITE_DATA_MODE=auto

# Desenvolvimento com os emuladores do Firebase (firebase emulators:start):
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Subcaminho de publicação. No GitHub Pages de projeto: /nome-do-repositorio/
# (o workflow preenche sozinho). Em desenvolvimento, deixe vazio.
VITE_BASE_PATH=
